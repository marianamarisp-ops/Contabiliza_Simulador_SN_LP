# Copie este arquivo para .env e preencha os valores.

PORT=3001
PUBLIC_APP_URL=http://localhost:3001

# Segredo longo e aleatório (sessões JWT internas)
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio-snlp

# Mesmo secret que você configurar no webhook da Cakto (produto novo SN x LP)
CAKTO_WEBHOOK_SECRET=troque-pelo-secret-do-webhook-cakto

# Credenciais para acessar /admin.html e APIs de administração
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Link de checkout Cakto deste produto (cole quando criar o produto)
# CAKTO_CHECKOUT_URL=https://pay.cakto.com.br/PLACEHOLDER

# E-mail automático da chave (obrigatório no Render: SMTP de saída é bloqueado)
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
CONTACT_EMAIL=

# SMTP só funciona fora do Render (ou com EMAIL_ALLOW_SMTP=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Contabiliza <noreply@seudominio.com>"

# --- Produção no Render ---
# PUBLIC_APP_URL pode ficar vazio: o servidor usa RENDER_EXTERNAL_URL.
# DATA_DIR=/var/data  # só se anexar disco persistente (plano pago)
# Sem disco, as licenças sobrevivem a deploys via backup no Apps Script (EMAIL_WEBHOOK_*).
